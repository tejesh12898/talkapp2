# TalkRoom environment variables
#
# The app runs fully with a realistic in-memory mock backend out of the box.
# Provide BOTH values below to switch to a real Supabase project (rooms,
# messages, and presence go live automatically — no code changes needed).
#
# Find these in your Supabase dashboard under Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
